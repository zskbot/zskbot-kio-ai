# Copy file này thành ".env" rồi điền giá trị thật. KHÔNG commit file .env.

# API key của Anthropic để KIO.ai trả lời bằng Claude thật.
# Lấy tại: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model dùng cho chat (mặc định claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Personal Access Token của GitHub, cần cho tool "github" (list repo, tạo issue...)
# Tạo tại: https://github.com/settings/tokens
GITHUB_TOKEN=

# Token tự chọn để bảo vệ các tool nhạy cảm (git/github/http/terminal).
# Client phải gửi header "X-Agent-Token: <giá trị này>" mới gọi được các tool đó.
# Nếu để trống, các tool nhạy cảm sẽ bị CHẶN mặc định (an toàn hơn).
AGENT_TOKEN=

# Thư mục workspace agent sẽ quét/thao tác. Mặc định là thư mục chứa server.py.
KIO_WORKSPACE=.

# Port server lắng nghe
PORT=8000

# Bật debug mode của Flask (0/1)
DEBUG=0
